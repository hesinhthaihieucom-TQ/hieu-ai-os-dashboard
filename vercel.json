{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/nhan-hieu/api/:path*", "destination": "/api/:path*" },
    { "source": "/san-pham-so/api/:path*", "destination": "/api/:path*" }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 300 },
    "api/cron/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/send-reminders", "schedule": "*/15 * * * *" }
  ],
  "headers": [
    {
      "source": "/nhan-hieu/js/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/nhan-hieu/style.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/nhan-hieu/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/nhan-hieu/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/tai-chinh/js/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/tai-chinh/style.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/he-sinh-thai-hieu/style.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/he-sinh-thai-hieu/script.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/san-pham-so/p/script.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/san-pham-so/p/style.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/san-pham-so/app.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/san-pham-so/app.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
